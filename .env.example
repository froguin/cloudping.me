# Production site only. Set these in the Vercel project, not in the repo.
# NEXT_PUBLIC_SITE_URL=https://cloudping.me
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX
# NEXT_PUBLIC_SITE_TELEMETRY=1
# NEXT_PUBLIC_HEALTH_JSON_URL=https://raw.githubusercontent.com/froguin/cloudping.me/status/latest.json
# PROBE_SECRET=  # server-only; GitHub Actions sends this to POST /api/probe
# PROBE_SECRET_PREV=  # optional previous value; origins accept both during rotation

# GitHub Actions Secrets (Settings > Secrets and variables > Actions)
# PROBE_URL=https://cloudping.me/api/probe
# PROBE_URL_AWS_ICN=https://xxxxxxxxxx.lambda-url.ap-northeast-2.on.aws/
# PROBE_SECRET=
# PROBE_SECRET_PREV=

# Probe Lambda (lambda/handler.ts, AWS ap-northeast-2)
# PROBE_ORIGIN_ID=aws-ap-northeast-2
# PROBE_ORIGIN_LABEL="AWS Lambda (ap-northeast-2)"
# PROBE_SECRET=
# PROBE_SECRET_PREV=

# Clock Lambda (lambda/clock.mjs, EventBridge 15-minute trigger)
# GITHUB_DISPATCH_TOKEN=  # fine-grained PAT (Actions: write)
# GITHUB_REPO=froguin/cloudping.me  # optional
# GITHUB_WORKFLOW=probe.yml  # optional
# GITHUB_REF=main  # optional

