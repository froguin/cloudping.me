# Copy to secrets.auto.tfvars (gitignored) and fill in real values for LOCAL runs.
# Terraform auto-loads *.auto.tfvars, so no TF_VAR_ exports are needed.
#
# These are also stored as SENSITIVE variables in the HCP workspace
# (org "froguin", project "cloudping") for the future remote-execution path.
# HCP sensitive variables are write-only (their values can't be read back via
# API/UI), which is why local runs keep their own copy here. Rotate in BOTH
# places when the secrets change.

# Bearer secret shared by all probe origins (AWS/GCP/Azure) and the probe workflow.
probe_secret = "REPLACE_ME"

# GitHub token the clock Lambda uses to workflow_dispatch probe.yml.
github_dispatch_token = "REPLACE_ME"
