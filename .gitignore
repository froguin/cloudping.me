# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
tsconfig.tsbuildinfo

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel
.env*
!.env.example

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log


# Terraform local secrets & state (HCP holds state; secrets via HCP vars or local TF_VAR_*)
infra/terraform/*.tfvars
infra/terraform/*.auto.tfvars
infra/terraform/.terraform/
infra/terraform/crash.log
